{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Environment Settings
    "module": "Nodenext",
    "moduleResolution": "Nodenext",
    "target": "ES2022",

    // Recommended Options
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "noEmit": true
